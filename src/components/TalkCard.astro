---
const { talk } = Astro.props;
const dateStr = talk.date ? new Date(talk.date).toLocaleDateString('it-IT', { year: 'numeric', month: 'short', day: 'numeric' }) : 'Data N/D';

// Genera un prompt per l'immagine basato sul titolo del talk e sullo stile richiesto
const basePrompt = "Studio Ghibli style illustration, digital line and wash, a young boy and a small retro robot sitting on a rooftop looking at an overgrown solarpunk city at sunset, cinematic lighting, concept: ";
const fullPrompt = basePrompt + talk.title;
const encodedPrompt = encodeURIComponent(fullPrompt);

// Usa Pollinations.ai per generare l'immagine on-the-fly
const thumbnailUrl = `https://image.pollinations.ai/prompt/${encodedPrompt}?width=600&height=400&nologo=true`;
---
<a href={talk.url} target="_blank" class="group flex flex-col md:flex-row bg-[#111] border border-white/10 rounded-3xl hover:border-brand-yellow/50 transition-all duration-500 hover:-translate-y-1 overflow-hidden">
    
    <!-- Thumbnail AI (Solarpunk / Studio Ghibli style) -->
    <div class="w-full md:w-72 h-56 md:h-auto relative bg-[#0a0a0a] flex-shrink-0 border-b md:border-b-0 md:border-r border-white/5 overflow-hidden">
        <!-- Mostra un placeholder di caricamento o il colore di sfondo finché l'immagine AI non viene caricata -->
        <div class="absolute inset-0 flex items-center justify-center text-zinc-800 animate-pulse">
            <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
        </div>
        <img 
            src={thumbnailUrl} 
            alt={`Copertina AI per: ${talk.title}`} 
            loading="lazy"
            class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 group-hover:-rotate-1 transition-transform duration-700 opacity-90 group-hover:opacity-100 z-10 relative" 
            onload="this.previousElementSibling.style.display='none';"
        />
        <!-- Overlay scuro per migliorare la leggibilità e l'integrazione -->
        <div class="absolute inset-0 bg-gradient-to-t md:bg-gradient-to-r from-[#111] via-transparent to-transparent opacity-80 md:opacity-100 z-20"></div>
    </div>

    <!-- Content -->
    <div class="p-8 flex flex-col flex-grow">
        <div class="flex justify-between items-start mb-4">
            <span class="text-xs font-bold tracking-widest text-brand-yellow uppercase bg-brand-yellow/10 px-3 py-1 rounded-full">{dateStr}</span>
        </div>
        <h3 class="text-2xl font-bold mb-3 group-hover:text-brand-yellow transition-colors leading-tight">{talk.title}</h3>
        <p class="text-zinc-500 line-clamp-3 text-sm leading-relaxed mb-6 flex-grow">{talk.excerpt}</p>
        <div class="flex items-center text-brand-yellow font-bold text-sm mt-auto">
            VEDI DETTAGLI 
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 ml-2 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
        </div>
    </div>
</a>